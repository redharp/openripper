# Core
OPENRIPPER_PORT=8080
OPENRIPPER_LIBRARY_HOST_PATH=./library
OPENRIPPER_LIBRARY_ROOT=/media/library
OPENRIPPER_MOVIE_ROOT=/media/library/Movies
OPENRIPPER_TV_ROOT=/media/library/TV
OPENRIPPER_DATABASE_URL=postgresql+psycopg://openripper:change-me@postgres:5432/openripper
OPENRIPPER_POLL_INTERVAL=8
OPENRIPPER_AUTO_RIP=true
# disc: unattended folders using the disc label; library: metadata-gated naming
OPENRIPPER_OUTPUT_MODE=disc
OPENRIPPER_EJECT_ON_SUCCESS=true
OPENRIPPER_MAX_CONCURRENT_RIPS=2

# Selection and publishing safety
OPENRIPPER_MIN_TITLE_SECONDS=1200
OPENRIPPER_AUTO_PUBLISH_CONFIDENCE=0.88
OPENRIPPER_RIP_MODE=smart

# Optional: TMDB v4 read access token, used only in library output mode.
OPENRIPPER_TMDB_TOKEN=

# MakeMKV
OPENRIPPER_MAKEMKV_BIN=makemkvcon
OPENRIPPER_MAKEMKV_KEY=
OPENRIPPER_UDEV_DISCOVERY=true

# Read-only check that shows whether each drive can rip 4K UHD.
OPENRIPPER_COMPATIBILITY_CHECK=true
OPENRIPPER_SDF_PATH=/opt/makemkv/appdata/sdf.bin

# PostgreSQL container
POSTGRES_DB=openripper
POSTGRES_USER=openripper
POSTGRES_PASSWORD=change-me

# Set true to demo the full dashboard without optical hardware.
OPENRIPPER_SIMULATE=false
